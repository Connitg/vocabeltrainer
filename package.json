  "private": true,
  "description": "Vokabeltrainer für Schüler: Spaced Repetition, Klassenarbeits-Modus, Ordner, Handschrift. Läuft offline, ohne Konto.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "serve": "node scripts/serve.mjs",
